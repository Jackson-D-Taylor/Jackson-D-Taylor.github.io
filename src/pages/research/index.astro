    font-size: 0.95rem;
  }

  .opening {
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .topic {
    margin-top: 3rem;
    max-width: var(--measure);
  }

  .topic h2 {
    margin-bottom: 0.7rem;
  }

  .topic p + p {
    margin-top: 1rem;
  }

  .quote {
    margin: 1.1rem 0 0;
    padding: 0.1rem 0 0.1rem 1.1rem;
    border-left: 3px solid var(--accent);
  }

  .quote p {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text);
  }

  .quote cite {
    display: block;
    margin-top: 0.45rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
</style>
