---
/**
 * Light / dark switch.
 *
 * The button is a toggle in the ARIA sense: its name is "Dark theme" and
 * aria-pressed says whether that theme is on. Which icon shows is decided in
 * CSS (see global.css), so the mark is correct even before this script runs.
 *
 * The control stays hidden until the inline script in <head> adds .js to the
 * document, so nobody without JavaScript meets a button that does nothing.
 */
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label="Dark theme"
>
  <svg class="tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8L6 18M18 6l1.8-1.8"></path>
  </svg>
  <svg class="tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  if (button) {
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    /** The theme actually in force right now, explicit choice or OS default. */
    const effective = (): 'light' | 'dark' => {
      const chosen = root.getAttribute('data-theme');
      if (chosen === 'light' || chosen === 'dark') return chosen;
      return media.matches ? 'dark' : 'light';
    };

    const reflect = () => {
      const now = effective();
      button.setAttribute('aria-pressed', now === 'dark' ? 'true' : 'false');
      button.setAttribute(
        'title',
        now === 'dark' ? 'Switch to the light theme' : 'Switch to the dark theme',
      );
    };

    button.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (err) {
        /* private mode: the choice holds for this page view only */
      }
      reflect();
    });

    /* Follow the OS while no explicit choice has been made. */
    media.addEventListener('change', () => {
      if (!root.hasAttribute('data-theme')) reflect();
    });

    reflect();
  }
</script>
