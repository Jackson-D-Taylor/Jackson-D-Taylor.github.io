---
/**
 * RedbackOrbit — explainer for
 * "Discovery of the redback pulsar PSR J2053+6905 and multi-epoch optical
 *  observations of the system" (Karpova et al. 2026, MNRAS advance article).
 *
 * One interaction: step around the orbit and watch two separate measurements
 * change together. The radio strip loses its pulses while the companion is in
 * the way; the optical curve bottoms out at the same moment, because that is
 * when the companion's unheated side faces us.
 *
 * Zero JavaScript. Eight radio buttons hold the state and CSS sibling
 * selectors switch the figure. Step one is rendered server-side and is
 * complete on its own.
 *
 * The paper is an unedited advance article, so this stays conceptual. Every
 * number quoted below is in the published abstract.
 */

const CX = 150;
const CY = 118;
const RX = 110;
const RY = 24;

const STEPS = [
  {
    n: 1,
    phi: 0,
    eclipse: false,
    text:
      'The companion is on the far side of the pulsar. Its heated face is turned towards us, so the system looks as bright as it gets, and the radio pulses arrive without interruption.',
  },
  {
    n: 2,
    phi: 45,
    eclipse: false,
    text:
      'The companion has moved a step past the far side. Most of the heated face still points our way and the pulses keep coming.',
  },
  {
    n: 3,
    phi: 90,
    eclipse: false,
    text:
      'The companion is off to one side of the pulsar as we see it. Half the heated face and half the cool face are in view, so the optical brightness is partway down.',
  },
  {
    n: 4,
    phi: 135,
    eclipse: true,
    text:
      'The companion is coming round towards the front. This is where material around it would start to cover the line of sight and cut off the radio pulses.',
  },
  {
    n: 5,
    phi: 180,
    eclipse: true,
    text:
      'The companion is directly in front of the pulsar. An eclipse would block the radio pulses here, and the cool, unheated side faces us, so the optical light curve is at its lowest.',
  },
  {
    n: 6,
    phi: 225,
    eclipse: true,
    text:
      'The companion is moving out from in front. If the pulses were eclipsed, they would come back about here.',
  },
  {
    n: 7,
    phi: 270,
    eclipse: false,
    text:
      'The companion is off to the other side. Half lit again, and the pulses are clear.',
  },
  {
    n: 8,
    phi: 315,
    eclipse: false,
    text:
      'The companion is nearly back behind the pulsar. The system is brightening towards maximum.',
  },
];

interface Placed {
  n: number;
  cx: number;
  cy: number;
  lit: string;
  markX: number;
}

const RAD = Math.PI / 180;
const COMP_R = 13;

function litHalf(cx: number, cy: number): string {
  const beta = Math.atan2(CY - cy, CX - cx);
  const a1 = beta - Math.PI / 2;
  const a2 = beta + Math.PI / 2;
  const x1 = (cx + COMP_R * Math.cos(a1)).toFixed(1);
  const y1 = (cy + COMP_R * Math.sin(a1)).toFixed(1);
  const x2 = (cx + COMP_R * Math.cos(a2)).toFixed(1);
  const y2 = (cy + COMP_R * Math.sin(a2)).toFixed(1);
  return `M${x1},${y1} A${COMP_R},${COMP_R} 0 0 1 ${x2},${y2} Z`;
}

const PLACED: Placed[] = STEPS.map((s) => {
  const cx = CX + RX * Math.cos(s.phi * RAD);
  const cy = CY + RY * Math.sin(s.phi * RAD);
  return {
    n: s.n,
    cx,
    cy,
    lit: litHalf(cx, cy),
    markX: 20 + (268 * (s.n - 1)) / 8,
  };
});

// --- panel B ---------------------------------------------------------------
const X0 = 20;
const XW = 268;
const RADIO_BASE = 104;
const ECL_FROM = X0 + XW * 0.375;
const ECL_TO = X0 + XW * 0.625;

const TICKS: number[] = [];
for (let x = 24; x <= 284; x += 7.5) {
  const p = (x - X0) / XW;
  if (p > 0.375 && p < 0.625) continue;
  TICKS.push(Math.round(x * 10) / 10);
}

function bright(p: number): number {
  const sym = (1 + Math.cos(2 * Math.PI * p)) / 2;
  const spot = 0.13 * Math.exp(-(((p - 0.73) / 0.11) ** 2));
  return Math.max(0, Math.min(1, sym - spot));
}

function curve(fn: (p: number) => number): string {
  const pts: string[] = [];
  for (let i = 0; i <= 160; i++) {
    const p = i / 160;
    const x = X0 + XW * p;
    const y = 216 - 76 * fn(p);
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return `M${pts.join(' L')}`;
}

const OBSERVED = curve(bright);
const SYMMETRIC = curve((p) => (1 + Math.cos(2 * Math.PI * p)) / 2);
---

<section class="rb-root exp" aria-labelledby="rb-title">
  <h3 id="rb-title" class="exp-title">One orbit, measured two ways</h3>

  <p class="exp-lede">
    PSR J2053+6905 is a 1.68-millisecond pulsar with a companion close enough that the
    pulsar's radiation heats the side of it that faces the pulsar. A radio telescope may lose the pulses for part of the orbit: in one of our four
    observing sessions the pulsar faded out partway through, most likely in an eclipse. An optical telescope sees the system brighten and fade as the heated face
    turns towards us and away. Step around the orbit and watch both at once.
  </p>

  <p class="exp-fidelity">
    <strong>Faithful:</strong> an eclipse would line up with the minimum of the light
    curve, for the reason the diagram shows, and the asymmetry in the optical curve is
    reported in the paper. <strong>Schematic:</strong> the viewing angle (the paper fits
    an inclination of about 66 degrees), the sizes, the separation, the width of the
    possible eclipse, and the shape and size of the asymmetry. Apart from the inclination,
    none of those are fitted values, and this paper is an unedited advance article.
  </p>

  <input class="rb-state" type="radio" name="rb-step" id="rb-1" checked />
  <input class="rb-state" type="radio" name="rb-step" id="rb-2" />
  <input class="rb-state" type="radio" name="rb-step" id="rb-3" />
  <input class="rb-state" type="radio" name="rb-step" id="rb-4" />
  <input class="rb-state" type="radio" name="rb-step" id="rb-5" />
  <input class="rb-state" type="radio" name="rb-step" id="rb-6" />
  <input class="rb-state" type="radio" name="rb-step" id="rb-7" />
  <input class="rb-state" type="radio" name="rb-step" id="rb-8" />

  <p class="rb-prompt">Eight equal steps around one orbit:</p>
  <div class="rb-chips">
    {
      STEPS.map((s) => (
        <label class="rb-chip" for={`rb-${s.n}`}>
          <span aria-hidden="true">{s.n}</span>
          <span class="rb-vh">{`Step ${s.n} of 8. ${s.text}`}</span>
        </label>
      ))
    }
  </div>

  <div class="rb-stage">
    <div class="exp-panels">
      <figure class="exp-panel">
        <svg
          class="rb-svg"
          viewBox="0 0 300 236"
          role="img"
          aria-label="The companion's position in its orbit around the pulsar, seen from the side, with Earth off to the left."
        >
          <ellipse class="rb-orbit" cx={CX} cy={CY} rx={RX} ry={RY} />
          <line class="rb-sight" x1={CX} y1={CY} x2="14" y2={CY} />
          <text class="rb-tag rb-dim" x="12" y={CY - 40}>to Earth</text>

          {
            PLACED.map((p) => (
              <g class={`rb-st rb-st-${p.n}`}>
                <circle class="rb-halo" cx={p.cx} cy={p.cy} r="30" />
                <circle class="rb-night" cx={p.cx} cy={p.cy} r={COMP_R} />
                <path class="rb-day" d={p.lit} />
              </g>
            ))
          }

          <circle class="rb-pulsar" cx={CX} cy={CY} r="6" />
          <text class="rb-tag" x={CX + 10} y={CY - 10}>pulsar</text>
          <text class="rb-tag rb-dim" x="150" y="206" text-anchor="middle">
            companion, heated face in orange
          </text>
          <text class="rb-tag rb-dim" x="150" y="222" text-anchor="middle">
            the faint ring is the material around it
          </text>
        </svg>
        <figcaption class="exp-cap">
          Earth is off to the left. The companion can only get in the way when it
          passes between us and the pulsar.
        </figcaption>
      </figure>

      <figure class="exp-panel">
        <svg
          class="rb-svg"
          viewBox="0 0 300 236"
          role="img"
          aria-label="Radio pulses across one orbit with a gap where a possible eclipse would fall, above an optical light curve with its minimum at the same phase."
        >
          <text class="rb-tag rb-dim" x={X0} y="24">radio pulses</text>
          <rect
            class="rb-eclipse"
            x={ECL_FROM}
            y="36"
            width={ECL_TO - ECL_FROM}
            height={RADIO_BASE - 36}
            rx="3"
          />
          <text class="rb-tag rb-dim" x={(ECL_FROM + ECL_TO) / 2} y="50" text-anchor="middle"
            >possible eclipse</text
          >
          <line class="rb-axis" x1={X0} y1={RADIO_BASE} x2={X0 + XW} y2={RADIO_BASE} />
          {TICKS.map((x) => <line class="rb-pulse" x1={x} y1={RADIO_BASE} x2={x} y2={RADIO_BASE - 34} />)}

          <text class="rb-tag rb-dim" x={X0} y="130">optical brightness</text>
          <line class="rb-axis" x1={X0} y1="216" x2={X0 + XW} y2="216" />
          <path class="rb-sym" d={SYMMETRIC} />
          <path class="rb-obs" d={OBSERVED} />
          <text class="rb-tag rb-dim" x={X0 + XW} y="232" text-anchor="end">one orbit &#8594;</text>

          {
            PLACED.map((p) => (
              <g class={`rb-st rb-st-${p.n}`}>
                <line class="rb-marker" x1={p.markX} y1="34" x2={p.markX} y2="226" />
                <polygon
                  class="rb-caret"
                  points={`${p.markX - 5},26 ${p.markX + 5},26 ${p.markX},34`}
                />
              </g>
            ))
          }
        </svg>
        <figcaption class="exp-cap">
          The dashed curve is a symmetric heating model. The solid curve is the kind of
          asymmetry the paper reports; the paper fits only the stable stretches of the
          real light curves.
        </figcaption>
      </figure>
    </div>

    <p class="exp-status" role="status" aria-live="polite">
      {STEPS.map((s) => <span class={`rb-st rb-st-${s.n}`}>{s.text}</span>)}
    </p>
  </div>

  <p class="exp-note">
    The two measurements constrain different things, which is why the paper uses both.
    Radio timing gives the spin period, the dispersion measure, the Keplerian orbital
    parameters and the pulsar mass function. Optical spectroscopy from the 10.4-m Gran
    Telescopio Canarias gives a radial velocity semi-amplitude of K = 337(4) km s<sup
      >&#8722;1</sup
    >, and putting that together with the mass function fixes the ratio of the two
    masses at M<sub>p</sub>/M<sub>c</sub> = 7.05(8). Fitting the stable segments of the
    light curves with a symmetric direct heating model then gives masses of about
    2.1 and about 0.3 solar masses. The light curves also change shape from epoch to
    epoch, which the paper puts down to a cold spot on the companion dissipating or
    moving.
  </p>

  <details class="exp-describe">
    <summary>Describe this figure in words</summary>
    <div class="exp-prose">
      <p>
        The left panel is the orbit seen from the side. A dot at the centre is the
        pulsar, and a long flattened ellipse is the path the companion follows around
        it. Earth is off to the left, and a line runs from the pulsar towards it to mark
        the line of sight. The companion is drawn as a small disc with one half shaded
        orange: that is the side facing the pulsar, the side being heated. Around it is a
        faint ring standing for the material shed from its surface. As you step through
        the eight positions, the companion travels round the ellipse and the orange half
        rotates with it, always pointing at the pulsar.
      </p>
      <p>
        The right panel shows one full orbit twice over, in two strips. The upper strip
        is the radio view: a row of evenly spaced pulses with a gap in the middle, shaded
        and marked as a possible eclipse. The lower strip is the optical view: a curve that
        peaks at both ends and dips to a minimum in the middle. A dashed version of the
        same curve, symmetric about the minimum, sits underneath for comparison, and the
        solid curve departs from it on one shoulder. A vertical line crossing both strips
        marks the step you are on.
      </p>
      <p>
        The thing to notice is that the gap in the radio pulses and the dip in the
        optical curve happen at the same place. Both come from the companion being
        between us and the pulsar. At that point its material would block the radio pulses,
        and the face it turns towards us is the cool one, pointing away from the heat.
        Half an orbit later the companion is behind the pulsar, the pulses are clear, and
        the heated face is in full view. The asymmetry in the solid curve is the part a simple heating model
        does not account for.
      </p>
    </div>
  </details>
</section>

<style>
  .exp {
    margin: 2.5rem 0;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    position: relative;
  }

  .exp-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .exp-lede {
    margin: 0 0 0.9rem;
    max-width: var(--measure, 38rem);
  }

  .exp-fidelity {
    margin: 0 0 1.1rem;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--accent-2);
    background: var(--bg);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .exp-fidelity strong {
    color: var(--text);
  }

  .rb-state {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .rb-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .rb-prompt {
    margin: 0 0 0.45rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .rb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .rb-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  #rb-1:checked ~ .rb-chips label[for='rb-1'],
  #rb-2:checked ~ .rb-chips label[for='rb-2'],
  #rb-3:checked ~ .rb-chips label[for='rb-3'],
  #rb-4:checked ~ .rb-chips label[for='rb-4'],
  #rb-5:checked ~ .rb-chips label[for='rb-5'],
  #rb-6:checked ~ .rb-chips label[for='rb-6'],
  #rb-7:checked ~ .rb-chips label[for='rb-7'],
  #rb-8:checked ~ .rb-chips label[for='rb-8'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  #rb-1:focus-visible ~ .rb-chips label[for='rb-1'],
  #rb-2:focus-visible ~ .rb-chips label[for='rb-2'],
  #rb-3:focus-visible ~ .rb-chips label[for='rb-3'],
  #rb-4:focus-visible ~ .rb-chips label[for='rb-4'],
  #rb-5:focus-visible ~ .rb-chips label[for='rb-5'],
  #rb-6:focus-visible ~ .rb-chips label[for='rb-6'],
  #rb-7:focus-visible ~ .rb-chips label[for='rb-7'],
  #rb-8:focus-visible ~ .rb-chips label[for='rb-8'] {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* one class set drives the orbit marker, the phase line and the readout */
  .rb-st {
    display: none;
  }

  .rb-st-1 {
    display: inline;
  }

  #rb-2:checked ~ .rb-stage .rb-st-1,
  #rb-3:checked ~ .rb-stage .rb-st-1,
  #rb-4:checked ~ .rb-stage .rb-st-1,
  #rb-5:checked ~ .rb-stage .rb-st-1,
  #rb-6:checked ~ .rb-stage .rb-st-1,
  #rb-7:checked ~ .rb-stage .rb-st-1,
  #rb-8:checked ~ .rb-stage .rb-st-1 {
    display: none;
  }

  #rb-2:checked ~ .rb-stage .rb-st-2,
  #rb-3:checked ~ .rb-stage .rb-st-3,
  #rb-4:checked ~ .rb-stage .rb-st-4,
  #rb-5:checked ~ .rb-stage .rb-st-5,
  #rb-6:checked ~ .rb-stage .rb-st-6,
  #rb-7:checked ~ .rb-stage .rb-st-7,
  #rb-8:checked ~ .rb-stage .rb-st-8 {
    display: inline;
  }

  .exp-panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 46rem) {
    .exp-panels {
      grid-template-columns: 1fr 1fr;
    }
  }

  .exp-panel {
    margin: 0;
  }

  .rb-svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
  }

  .exp-cap {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* --- svg pieces --- */
  .rb-orbit {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  .rb-sight {
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .rb-pulsar {
    fill: var(--accent);
  }

  .rb-night {
    fill: var(--text-muted);
    opacity: 0.55;
  }

  .rb-day {
    fill: var(--accent-2);
  }

  .rb-halo {
    fill: var(--accent-2);
    opacity: 0.13;
  }

  .rb-tag {
    font-size: 12.5px;
    fill: var(--text);
  }

  .rb-dim {
    fill: var(--text-muted);
  }

  .rb-axis {
    stroke: var(--border);
    stroke-width: 1.25;
  }

  .rb-pulse {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .rb-eclipse {
    fill: var(--text-muted);
    opacity: 0.16;
  }

  .rb-sym {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.25;
    stroke-dasharray: 4 4;
  }

  .rb-obs {
    fill: none;
    stroke: var(--accent-2);
    stroke-width: 2.25;
  }

  .rb-marker {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
    opacity: 0.85;
  }

  .rb-caret {
    fill: var(--accent);
  }

  .exp-status {
    margin: 1.1rem 0 0;
    padding: 0.6rem 0.75rem;
    border: 1px dashed var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .exp-note {
    margin: 1rem 0 0;
    max-width: var(--measure, 38rem);
    font-size: 0.95rem;
  }

  .exp-describe {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }

  .exp-describe > summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }

  .exp-describe > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .exp-prose {
    max-width: var(--measure, 38rem);
    font-size: 0.95rem;
  }

  .exp-prose p {
    margin: 0 0 0.8rem;
  }

  .rb-chip {
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-chip {
      transition: none;
    }
  }

  @media print {
    .rb-prompt,
    .rb-chips,
    .exp-describe {
      display: none;
    }

    .exp {
      break-inside: avoid;
    }
  }
</style>
