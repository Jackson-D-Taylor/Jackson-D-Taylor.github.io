<script>
  type St = { n: number; r: number[]; pre: number[]; post: number[]; c: number; ym: number };

  function init(root: HTMLElement) {
    const tag = root.querySelector('[data-ct-model]');
    if (!tag || !tag.textContent) return;
    const M = JSON.parse(tag.textContent);
    const g = M.geom;
    const states: St[] = M.s;
    const sig: number = M.sig;
    function q<T extends Element>(s: string) {
      return root.querySelector(s) as T;
    }

    const range = q<HTMLInputElement>('#ct-range');
    const out = q<HTMLElement>('#ct-out');
    const status = q<HTMLElement>('#ct-status');
    const chi = q<HTMLElement>('#ct-chi');
    const pred = q<HTMLElement>('#ct-pred');
    const band = q<SVGRectElement>('#ct-band');
    const pre = q<SVGPathElement>('#ct-pre');
    const post = q<SVGPathElement>('#ct-post');
    const para = q<SVGPathElement>('#ct-para');
    const curline = q<SVGLineElement>('#ct-curline');
    const imax = q<SVGTextElement>('#ct-imax');
    const ytop = q<SVGTextElement>('#ct-ytop');
    const ybot = q<SVGTextElement>('#ct-ybot');
    const scale = q<HTMLElement>('#ct-scale');
    const runBtn = q<HTMLButtonElement>('#ct-run');
    const resetBtn = q<HTMLButtonElement>('#ct-reset');
    const dots = Array.from(root.querySelectorAll<SVGCircleElement>('.pt'));
    const cands = Array.from(root.querySelectorAll<SVGCircleElement>('.cand'));

    const xOf = (t: number) => g.PX0 + (t / g.SPAN) * (g.PX1 - g.PX0);
    const ixOf = (n: number) => g.IX0 + ((n - M.nmin) / 12) * (g.IX1 - g.IX0);
    const st = (n: number) => states[n - M.nmin];
    const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six'];
    const say = (n: number) => (n === 0 ? 'zero' : (n > 0 ? 'plus ' : 'minus ') + words[Math.abs(n)]);

    const tried = new Map<number, 'tried' | 'pruned' | 'best'>();
    tried.set(M.startN, 'tried');
    let cur = M.startN as number;
    let timer = 0;
    let search: ReturnType<typeof makeSearch> | null = null;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    function draw(n: number) {
      const s = st(n);
      const S: number = M.yscale;
      const yOf = (r: number) => g.RY - (r / S) * g.RH;
      for (let i = 0; i < dots.length; i++) dots[i].setAttribute('cy', yOf(s.r[i]).toFixed(1));
      const path = (ts: number[], vs: number[]) =>
        ts.map((t, i) => `${i ? 'L' : 'M'}${xOf(t).toFixed(1)} ${yOf(vs[i]).toFixed(1)}`).join(' ');
      pre.setAttribute('d', path(M.preT, s.pre));
      post.setAttribute('d', path(M.postT, s.post));
      const h = (sig / S) * g.RH;
      band.setAttribute('y', String(g.RY - h));
      band.setAttribute('height', String(2 * h));
      ytop.textContent = '+' + S.toFixed(0);
      ybot.textContent = '−' + S.toFixed(0);
      scale.textContent = '±' + S.toFixed(0);
      chi.textContent = s.c < 10 ? s.c.toFixed(2) : s.c.toFixed(0);
      out.textContent = (n > 0 ? '+' : '') + n;
      curline.setAttribute('x1', String(ixOf(n)));
      curline.setAttribute('x2', String(ixOf(n)));
    }

    function drawInset() {
      let max = 1;
      tried.forEach((_, n) => (max = Math.max(max, st(n).c)));
      const iy = (c: number) => g.IAY - (c / max) * (g.IAY - g.ITOP);
      for (const el of cands) {
        const n = Number(el.dataset.n);
        const state = tried.get(n);
        el.dataset.state = state || 'untried';
        el.setAttribute('cy', state ? iy(st(n).c).toFixed(1) : String(g.IAY));
        el.setAttribute('r', state ? '4' : '2.2');
      }
      imax.textContent = 'score ' + max.toFixed(max < 10 ? 1 : 0);

      const pts = Array.from(tried.keys()).sort((a, b) => a - b);
      if (pts.length < 3) {
        para.setAttribute('d', '');
        pred.textContent = 'Try three or more counts and a curve appears through the scores.';
        return;
      }
      const fit = quad(pts.map((n) => [n, st(n).c] as [number, number]));
      if (!fit || fit[0] <= 0) {
        para.setAttribute('d', '');
        return;
      }
      const [a, b, c] = fit;
      let d = '';
      let pen = false;
      for (let n = M.nmin; n <= M.nmin + 12; n += 0.25) {
        const v = a * n * n + b * n + c;
        if (v < 0 || v > max * 1.02) {
          pen = false;
          continue;
        }
        d += (pen ? 'L' : 'M') + ixOf(n).toFixed(1) + ' ' + iy(v).toFixed(1) + ' ';
        pen = true;
      }
      para.setAttribute('d', d);
      const vertex = Math.round(-b / (2 * a));
      pred.textContent =
        'The curve through your scores bottoms out at ' +
        (vertex > 0 ? '+' : '') +
        vertex +
        (tried.has(vertex) ? '.' : '. That is the count to check next.');
    }

    function quad(p: [number, number][]) {
      const A = [
        [0, 0, 0],
        [0, 0, 0],
        [0, 0, 0],
      ];
      const v = [0, 0, 0];
      for (const [x, y] of p) {
        const row = [x * x, x, 1];
        for (let i = 0; i < 3; i++) {
          v[i] += row[i] * y;
          for (let j = 0; j < 3; j++) A[i][j] += row[i] * row[j];
        }
      }
      const Mx = A.map((r, i) => [...r, v[i]]);
      for (let c = 0; c < 3; c++) {
        let pv = c;
        for (let i = c + 1; i < 3; i++) if (Math.abs(Mx[i][c]) > Math.abs(Mx[pv][c])) pv = i;
        const t = Mx[c];
        Mx[c] = Mx[pv];
        Mx[pv] = t;
        if (Math.abs(Mx[c][c]) < 1e-12) return null;
        for (let i = 0; i < 3; i++) {
          if (i === c) continue;
          const f = Mx[i][c] / Mx[c][c];
          for (let j = c; j < 4; j++) Mx[i][j] -= f * Mx[c][j];
        }
      }
      return [Mx[0][3] / Mx[0][0], Mx[1][3] / Mx[1][1], Mx[2][3] / Mx[2][2]];
    }

    let sayTimer = 0;
    function announce(extra?: string) {
      clearTimeout(sayTimer);
      sayTimer = window.setTimeout(() => {
        const s = st(cur);
        const e = Math.abs(cur - M.trueN);
        let shape: string;
        if (e === 0) shape = 'This count fits, and the points scatter above and below the line with no shape left in them.';
        else if (e === 1) shape = 'The points lean into a shallow curve.';
        else shape = 'The points curve away from the line, and the bend is deeper than it was.';
        status.textContent =
          (extra ? extra + ' ' : '') +
          'Missed turns: ' + say(cur) + '. Fit score ' + (s.c < 10 ? s.c.toFixed(2) : s.c.toFixed(0)) + '. ' + shape;
      }, 320);
    }

    function setN(n: number, record: boolean) {
      cur = n;
      range.value = String(n);
      if (record && !tried.has(n)) tried.set(n, 'tried');
      draw(n);
      drawInset();
    }

    // Search: walk outward from the current count, keep going down each way,
    // drop a direction as soon as its score turns back up.
    function makeSearch(from: number) {
      let lo = from - 1;
      let hi = from + 1;
      let lastLo = st(from).c;
      let lastHi = lastLo;
      let deadLo = lo < M.nmin;
      let deadHi = hi > M.nmin + 12;
      let best = from;
      return {
        done: () => deadLo && deadHi,
        best: () => best,
        step() {
          const goLo = !deadLo && (deadHi || lastLo <= lastHi);
          const n = goLo ? lo : hi;
          const c = st(n).c;
          const prev = goLo ? lastLo : lastHi;
          if (c < prev) {
            tried.set(n, 'tried');
            if (c < st(best).c) best = n;
          } else {
            tried.set(n, 'pruned');
          }
          if (goLo) {
            lastLo = c;
            lo -= 1;
            if (c >= prev || lo < M.nmin) deadLo = true;
          } else {
            lastHi = c;
            hi += 1;
            if (c >= prev || hi > M.nmin + 12) deadHi = true;
          }
          setN(n, false);
          return n;
        },
      };
    }

    function stopRun() {
      if (timer) {
        clearInterval(timer);
        timer = 0;
      }
      search = null;
      runBtn.textContent = reduced.matches ? 'Step the algorithm once' : 'Let the algorithm try';
    }

    function finish() {
      const b = search ? search.best() : cur;
      tried.set(b, 'best');
      setN(b, false);
      announce('The search has finished.');
      stopRun();
    }

    function oneStep() {
      if (!search) search = makeSearch(cur);
      if (search.done()) {
        finish();
        return;
      }
      search.step();
      if (search.done()) finish();
      else announce();
    }

    range.addEventListener('input', () => {
      stopRun();
      setN(Number(range.value), true);
      announce();
    });

    runBtn.addEventListener('click', () => {
      if (timer) {
        stopRun();
        return;
      }
      if (reduced.matches) {
        oneStep();
        return;
      }
      if (!search) search = makeSearch(cur);
      runBtn.textContent = 'Stop';
      timer = window.setInterval(oneStep, 480);
    });

    resetBtn.addEventListener('click', () => {
      stopRun();
      tried.clear();
      tried.set(M.startN, 'tried');
      setN(M.startN, false);
      announce();
    });

    function syncLabel() {
      if (!timer) runBtn.textContent = reduced.matches ? 'Step the algorithm once' : 'Let the algorithm try';
    }
    if (reduced.addEventListener) reduced.addEventListener('change', syncLabel);
    syncLabel();

    const ctrls = q<HTMLElement>('#ct-controls');
    ctrls.hidden = false;
    draw(cur);
    drawInset();
  }

  const roots = document.querySelectorAll<HTMLElement>('[data-explainer="count-the-turns"]');
  if (roots.length) {
    const io = new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        obs.unobserve(e.target);
        init(e.target as HTMLElement);
      }
    }, { rootMargin: '200px' });
    roots.forEach((r) => io.observe(r));
  }
</script>
