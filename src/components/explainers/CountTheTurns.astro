---
/**
 * Count the turns — explainer for "Algorithmic Pulsar Timer for Binaries".
 *
 * A pulsar's rotations have to be counted exactly, including across gaps when
 * nobody was observing. The count is an integer, so a wrong count does not blur
 * the fit, it bends it. The fit score has one sharp minimum with smooth sides,
 * and that is what makes a search possible at all.
 *
 * Every state the reader can reach is computed here, at build time, and shipped
 * as a small JSON payload. The browser script only draws. That keeps the server
 * render and the interactive render identical by construction, and keeps the
 * client script small.
 *
 * The model: arrival times in five short observing sessions separated by gaps,
 * one of them long. Assuming n missed turns across the long gap adds n whole
 * turns of phase to everything after it. A three-term polynomial (phase,
 * frequency, frequency derivative) is then fit by least squares and subtracted.
 * Because the residuals are linear in n after that projection, the reduced chi
 * squared is exactly quadratic in n — verified to machine precision.
 */

const SPAN = 480; // days covered
const CENTERS = [10, 50, 90, 430, 470]; // observing session centres, days
const PER = 5; // arrival times per session
const HALF = 7; // half-length of a session, days
const GAP_T = 257; // a day inside the long gap
const K = 40; // phase per missed turn (arbitrary units)
const SIG = 1; // uncertainty on each arrival time (arbitrary units)
const TRUE_N = 2; // the count that actually happened
const START_N = -3; // where the slider starts: wrong, so there is something to do
const NMIN = -6;
const NMAX = 6;

function lcg(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

const rand = lcg(20240322);
const times: number[] = [];
for (const c of CENTERS) {
  for (let i = 0; i < PER; i++) times.push(c - HALF + (2 * HALF * i) / (PER - 1));
}
const noise = times.map(() => {
  const a = Math.max(rand(), 1e-9);
  const b = rand();
  return SIG * Math.sqrt(-2 * Math.log(a)) * Math.cos(2 * Math.PI * b);
});
const un = (t: number) => (t - SPAN / 2) / (SPAN / 2);
const afterGap = times.map((t) => (t > GAP_T ? 1 : 0));

function solve3(A: number[][], b: number[]) {
  const M = A.map((row, i) => [...row, b[i]]);
  for (let c = 0; c < 3; c++) {
    let p = c;
    for (let i = c + 1; i < 3; i++) if (Math.abs(M[i][c]) > Math.abs(M[p][c])) p = i;
    const tmp = M[c];
    M[c] = M[p];
    M[p] = tmp;
    for (let i = 0; i < 3; i++) {
      if (i === c) continue;
      const f = M[i][c] / M[c][c];
      for (let j = c; j < 4; j++) M[i][j] -= f * M[c][j];
    }
  }
  return [M[0][3] / M[0][0], M[1][3] / M[1][1], M[2][3] / M[2][2]];
}

const PRE_T = [0, 24, 48, 72, 96];
const POST_T = [420, 440, 460, 480];

function stateFor(n: number) {
  const e = n - TRUE_N;
  const y = times.map((_, i) => e * K * afterGap[i] + noise[i]);
  const A = [
    [0, 0, 0],
    [0, 0, 0],
    [0, 0, 0],
  ];
  const b = [0, 0, 0];
  for (let i = 0; i < y.length; i++) {
    const u = un(times[i]);
    const row = [1, u, u * u];
    for (let a = 0; a < 3; a++) {
      b[a] += row[a] * y[i];
      for (let c = 0; c < 3; c++) A[a][c] += row[a] * row[c];
    }
  }
  const beta = solve3(A, b);
  const poly = (t: number) => {
    const u = un(t);
    return beta[0] + beta[1] * u + beta[2] * u * u;
  };
  const res = y.map((yi, i) => yi - poly(times[i]));
  const chi2 = res.reduce((s, x) => s + (x * x) / (SIG * SIG), 0) / (y.length - 3);
  const r2 = (x: number) => Math.round(x * 100) / 100;
  return {
    n,
    r: res.map(r2),
    pre: PRE_T.map((t) => r2(-poly(t))),
    post: POST_T.map((t) => r2(e * K - poly(t))),
    c: Math.round(chi2 * 1000) / 1000,
    ym: r2(Math.max(...res.map(Math.abs))),
  };
}

const states = [];
for (let n = NMIN; n <= NMAX; n++) states.push(stateFor(n));

// --- plot geometry -------------------------------------------------------
const PX0 = 56;
const PX1 = 638;
const AY = 78; // timeline baseline
const RY = 250; // residual zero line
const RH = 96; // residual half height
const xOf = (t: number) => PX0 + (t / SPAN) * (PX1 - PX0);

const start = states[START_N - NMIN];
// One vertical scale for every count on the slider, wide enough for the worst
// one and rounded up to a tidy number. Keeping it fixed is the point: the reader
// should see the residuals grow and shrink, which a rescaling axis would hide.
const S0 = Math.ceil(Math.max(...states.map((s) => s.ym * 1.18), 3.2 * SIG) / 10) * 10;
const yOf = (r: number, s: number) => RY - (r / s) * RH;
const band0 = (SIG / S0) * RH;

const preD = PRE_T.map((t, i) => `${i ? 'L' : 'M'}${xOf(t).toFixed(1)} ${yOf(start.pre[i], S0).toFixed(1)}`).join(' ');
const postD = POST_T.map((t, i) => `${i ? 'L' : 'M'}${xOf(t).toFixed(1)} ${yOf(start.post[i], S0).toFixed(1)}`).join(' ');

const gapStart = xOf(CENTERS[2] + HALF);
const gapEnd = xOf(CENTERS[3] - HALF);
const gapDays = Math.round(CENTERS[3] - HALF - (CENTERS[2] + HALF));

// --- score inset geometry ------------------------------------------------
const IX0 = 38;
const IX1 = 306;
const IAY = 134; // inset axis line
const ITOP = 28;
const ixOf = (n: number) => IX0 + ((n - NMIN) / (NMAX - NMIN)) * (IX1 - IX0);
const iyOf = (c: number, max: number) => IAY - (c / max) * (IAY - ITOP);
const CMAX0 = start.c;

const cand = [];
for (let n = NMIN; n <= NMAX; n++) cand.push(n);

const payload = {
  t: times.map((t) => Math.round(t * 10) / 10),
  preT: PRE_T,
  postT: POST_T,
  trueN: TRUE_N,
  startN: START_N,
  nmin: NMIN,
  sig: SIG,
  yscale: S0,
  s: states,
  geom: { PX0, PX1, RY, RH, SPAN, IX0, IX1, IAY, ITOP },
};

const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six'];
const sayN = (n: number) => (n === 0 ? 'zero' : (n > 0 ? 'plus ' : 'minus ') + words[Math.abs(n)]);
const startSay = `Missed turns: ${sayN(START_N)}. Fit score ${start.c < 10 ? start.c.toFixed(2) : start.c.toFixed(0)}. The points bend away from the line in a smooth curve.`;
---

<figure class="ex" data-explainer="count-the-turns">
  <figcaption>
    <b class="ex-title">Counting the turns across a gap</b>
    <p>
      A millisecond pulsar turns a few hundred times a second. Timing one means
      accounting for every rotation, including the ones that happened while the
      telescope was pointed somewhere else. The count is a whole number, and a
      wrong count leaves a smooth pattern in the data.
    </p>
  </figcaption>

  <svg class="main" viewBox="0 0 660 392" role="img" aria-labelledby="ct-t ct-d" preserveAspectRatio="xMidYMid meet">
    <title id="ct-t">Observing sessions above, timing residuals below</title>
    <desc id="ct-d">
      Five short observing sessions spread over 480 days, with one gap of about {gapDays} days. Underneath, the difference between each measured arrival
      time and the one predicted by the fit, for the count currently chosen.
    </desc>
    <defs>
      <clipPath id="ct-clip">
        <rect x={PX0} y={RY - RH - 8} width={PX1 - PX0} height={2 * RH + 16}></rect>
      </clipPath>
    </defs>

    <text class="lbl" x={PX0} y="26">When the telescope was looking</text>
    <rect class="gap" x={gapStart} y={AY - 26} width={gapEnd - gapStart} height="40"></rect>
    <line class="axis" x1={PX0} y1={AY + 14} x2={PX1} y2={AY + 14}></line>
    {times.map((t) => <line class="toa" x1={xOf(t)} y1={AY - 14} x2={xOf(t)} y2={AY + 14} />)}
    <text class="gaplbl" x={(gapStart + gapEnd) / 2} y={AY + 1} text-anchor="middle">
      {gapDays} days unobserved
    </text>
    <text class="tiny hide-sm" x={(gapStart + gapEnd) / 2} y={AY + 32} text-anchor="middle">
      the pulsar kept turning the whole time
    </text>

    <text class="lbl" x={PX0} y={RY - RH - 24}>Arrival time minus predicted arrival time</text>
    <line class="axis" x1={PX0} y1={RY} x2={PX1} y2={RY}></line>
    <rect class="band" id="ct-band" x={PX0} y={RY - band0} width={PX1 - PX0} height={2 * band0}></rect>
    <g clip-path="url(#ct-clip)">
      <path class="curve" id="ct-pre" d={preD}></path>
      <path class="curve" id="ct-post" d={postD}></path>
      {times.map((t, i) => (
        <circle class="pt" data-i={i} cx={xOf(t)} cy={yOf(start.r[i], S0)} r="3.4" />
      ))}
    </g>
    <text class="tiny" x={PX0 - 8} y={RY - RH + 4} text-anchor="end" id="ct-ytop">+{S0.toFixed(0)}</text>
    <text class="tiny" x={PX0 - 8} y={RY + 4} text-anchor="end">0</text>
    <text class="tiny" x={PX0 - 8} y={RY + RH + 4} text-anchor="end" id="ct-ybot">−{S0.toFixed(0)}</text>
    <text class="tiny" x={PX0} y={RY + RH + 26}>day 0</text>
    <text class="tiny" x={PX1} y={RY + RH + 26} text-anchor="end">day {SPAN}</text>
  </svg>

  <p class="scalenote">
    Vertical scale: <span id="ct-scale">±{S0.toFixed(0)}</span> in arbitrary units,
    the same for every count. The gray band reaches one uncertainty above and below zero.
  </p>

  <noscript>
    <p class="note">
      This figure is interactive. With JavaScript off it stays on one guess, {sayN(START_N)},
      which is {words[Math.abs(START_N - TRUE_N)]} turns away from the
      right answer of {sayN(TRUE_N)}. The written walkthrough below covers the rest.
    </p>
  </noscript>

  <div class="controls" id="ct-controls" hidden>
    <label class="slabel" for="ct-range">How many turns did you miss during the gap?</label>
    <div class="srow">
      <input type="range" id="ct-range" min={NMIN} max={NMAX} step="1" value={START_N} />
      <output class="val" id="ct-out" for="ct-range">{START_N}</output>
    </div>
    <p class="hint">Negative means you counted too many. Arrow keys move one turn at a time.</p>
    <div class="btns">
      <button type="button" id="ct-run">Let the algorithm try</button>
      <button type="button" id="ct-reset">Start over</button>
    </div>
  </div>

  <div class="scorebox">
    <div class="scoretext">
      <p class="score">Fit score (reduced χ²): <strong id="ct-chi">{start.c.toFixed(2)}</strong></p>
      <p class="tinyp">
        A score near one means the points miss the fit by about their measurement
        uncertainty. A much larger score means there is still a pattern in the data
        that the fit can't account for.
      </p>
      <p class="pred" id="ct-pred">Try three or more counts and a curve appears through the scores.</p>
    </div>
    <svg class="inset" viewBox="0 0 320 184" role="img" aria-labelledby="ct-it ct-id">
      <title id="ct-it">Fit score against assumed count</title>
      <desc id="ct-id">
        Every whole number from {NMIN} to {NMAX} sits on the axis. Each count you
        try rises to its fit score. Three or more scores are enough to draw the
        curve they lie on.
      </desc>
      <line class="axis" x1={IX0 - 8} y1={IAY} x2={IX1 + 8} y2={IAY}></line>
      <path class="para" id="ct-para" d=""></path>
      {cand.map((n) => (
        <circle
          class="cand"
          data-n={n}
          data-state={n === START_N ? 'tried' : 'untried'}
          cx={ixOf(n)}
          cy={n === START_N ? iyOf(start.c, CMAX0) : IAY}
          r={n === START_N ? 4 : 2.2}
        />
      ))}
      <line class="curline" id="ct-curline" x1={ixOf(START_N)} y1={ITOP - 8} x2={ixOf(START_N)} y2={IAY + 8}></line>
      <text class="tiny" x={ixOf(NMIN)} y={IAY + 22} text-anchor="middle">{NMIN}</text>
      <text class="tiny" x={ixOf(0)} y={IAY + 22} text-anchor="middle">0</text>
      <text class="tiny" x={ixOf(NMAX)} y={IAY + 22} text-anchor="middle">+{NMAX}</text>
      <text class="tiny" x={IX0 - 8} y={IAY + 42}>assumed count</text>
      <text class="tiny" x={IX0 - 30} y={ITOP - 12} id="ct-imax">score {CMAX0.toFixed(0)}</text>
    </svg>
  </div>

  <p class="status" id="ct-status" role="status" aria-live="polite">{startSay}</p>

  <div class="honesty">
    <p>
      This is a simplified version of the problem. The arrival times are made up, the
      units are arbitrary, and the fit is a three-term polynomial with no binary orbit
      in it. Real data are fit with a full timing model. Our algorithm also prunes on
      reduced χ², but before cutting a branch it uses an F-test to decide whether adding
      a fit parameter rescues it, and that step is left out here.
    </p>
  </div>

  <details class="describe">
    <summary>Describe this figure in words</summary>
    <div class="prose">
      <p>
        The upper strip is a calendar. Five short observing sessions, five arrival
        times each, are marked as vertical ticks. The first three sessions sit
        close together in the first three months. Then there is nothing for about {gapDays} days,
        which is the shaded block, and the last two sessions sit at the far right.
      </p>
      <p>
        The lower panel plots, for each arrival time, how far it landed from where
        the fit said it would. The horizontal line is zero. The gray band is one measurement uncertainty on either side of it. The smooth line through the
        points is what the chosen count predicts before the noise is added.
      </p>
      <p>
        At the correct count the points sit inside or near the gray band with no order to them. The smooth line is flat on
        zero, and the fit score is about one.
      </p>
      <p>
        At any other count, the points leave the band and lie along a curve that
        sags on one side and rises on the other.
      </p>
      <p>
        The small panel on the right keeps track of the counts you have tried. Every whole number from {NMIN} to {NMAX} is a dot on the axis. When you try one, its dot rises to
        the fit score it earned. After three tries the dots turn out to lie on a
        parabola, and once you know the parabola you can read off where its lowest
        point is without trying every value, which is the shortcut the paper uses.
      </p>
      <p>
        The button walks a search outward from wherever you left the slider. It
        takes a step, keeps going in that direction while the score falls, and
        stops that direction as soon as the score rises. Both directions close in
        on the same answer, which here is {TRUE_N} turns with a fit score near one.
      </p>
      <p>
        The longer the gap, the more counts give a score close to the best one, and
        the harder the problem gets. A gap of a few days can usually be bridged by
        eye.
      </p>
    </div>
  </details>

  <script type="application/json" data-ct-model is:inline set:html={JSON.stringify(payload)} />
</figure>

