<script>
  const MU = 0.01 / 1.41;
  const H = 0.005; // fixed integration step, independent of frame rate
  const RATE = 2.2; // simulation time units per real second
  const SAMPLE = 0.05; // how often the timing trace is sampled
  const TAU = Math.PI * 2;
  const KEEP = Math.round((6 * TAU) / SAMPLE); // six orbits of trace

  type V = [number, number, number, number];

  function deriv(s: V): V {
    const [x, y, vx, vy] = s;
    const a1 = x + MU;
    const a2 = x - 1 + MU;
    const r1 = Math.pow(a1 * a1 + y * y, 1.5);
    const r2 = Math.pow(a2 * a2 + y * y, 1.5);
    return [
      vx,
      vy,
      2 * vy + x - ((1 - MU) * a1) / r1 - (MU * a2) / r2,
      -2 * vx + y - ((1 - MU) * y) / r1 - (MU * y) / r2,
    ];
  }

  function rk4(s: V, h: number): V {
    const a = deriv(s);
    const b = deriv(s.map((v, i) => v + (h / 2) * a[i]) as V);
    const c = deriv(s.map((v, i) => v + (h / 2) * b[i]) as V);
    const d = deriv(s.map((v, i) => v + h * c[i]) as V);
    return s.map((v, i) => v + (h / 6) * (a[i] + 2 * b[i] + 2 * c[i] + d[i])) as V;
  }

  function init(root: HTMLElement) {
    const tag = root.querySelector('[data-tl-presets]');
    if (!tag || !tag.textContent) return null;
    const cfg = JSON.parse(tag.textContent) as {
      presets: { id: string; label: string; deg: number; words: string }[];
      start: string;
    };
    const sim = root.querySelector('#tl-sim') as HTMLElement;
    const orbit = root.querySelector('#tl-orbit') as HTMLCanvasElement;
    const strip = root.querySelector('#tl-strip') as HTMLCanvasElement;
    const playBtn = root.querySelector('#tl-play') as HTMLButtonElement;
    const stepBtn = root.querySelector('#tl-step') as HTMLButtonElement;
    const resetBtn = root.querySelector('#tl-reset') as HTMLButtonElement;
    const status = root.querySelector('#tl-status') as HTMLElement;
    const rm = root.querySelector('#tl-rm') as HTMLElement;
    const octx = orbit.getContext('2d')!;
    const sctx = strip.getContext('2d')!;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    sim.hidden = false;
    if (reduced.matches) {
      rm.hidden = false;
      sim.classList.add('step-first');
    }

    let pick = cfg.presets.find((p) => p.id === cfg.start)!;
    let s: V = [0, 0, 0, 0];
    let t = 0;
    let nextSample = 0;
    let trail: number[] = [];
    let trace: number[] = [];
    let playing = false;
    let raf = 0;
    let last = 0;

    const col = { text: '#000', muted: '#888', accent: '#1F5F8B', accent2: '#C2772A', border: '#ddd' };
    function readColors() {
      const cs = getComputedStyle(root);
      const g = (n: string, f: string) => cs.getPropertyValue(n).trim() || f;
      col.text = g('--text', col.text);
      col.muted = g('--text-muted', col.muted);
      col.accent = g('--accent', col.accent);
      col.accent2 = g('--accent-2', col.accent2);
      col.border = g('--border', col.border);
    }

    function place(deg: number) {
      const th = ((60 + deg) * Math.PI) / 180;
      s = [-MU + Math.cos(th), Math.sin(th), 0, 0];
      t = 0;
      nextSample = 0;
      trail = [];
      trace = [];
      record();
    }

    function record() {
      trail.push(s[0], s[1]);
      if (trail.length > 7000) trail.splice(0, 2000);
      // The pulsar's reflex is opposite the asteroid, rotated back into the sky
      // frame; the telescope sees one component of it.
      trace.push(-(s[0] * Math.cos(t) - s[1] * Math.sin(t)));
      if (trace.length > KEEP) trace.shift();
      nextSample = t + SAMPLE;
    }

    function advance(dur: number) {
      let n = 0;
      while (dur > 0 && n < 4000) {
        s = rk4(s, H);
        t += H;
        dur -= H;
        n++;
        if (t >= nextSample) record();
      }
    }

    function fit(c: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
      const r = c.getBoundingClientRect();
      if (!r.width) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(r.width * dpr);
      const h = Math.round(r.height * dpr);
      if (c.width !== w || c.height !== h) {
        c.width = w;
        c.height = h;
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, r.width, r.height);
      return true;
    }

    function drawOrbit() {
      const r = orbit.getBoundingClientRect();
      if (!fit(orbit, octx)) return;
      const W = r.width;
      const Ht = r.height;
      const cx = W * 0.5;
      const cy = Ht * 0.55;
      const sc = Math.min(W * 0.33, Ht * 0.42);
      const X = (x: number) => cx + sc * (x + MU);
      const Y = (y: number) => cy - sc * y;

      octx.strokeStyle = col.border;
      octx.lineWidth = 1;
      octx.setLineDash([4, 5]);
      octx.beginPath();
      octx.arc(X(-MU), Y(0), sc, 0, TAU);
      octx.stroke();

      octx.strokeStyle = col.muted;
      octx.beginPath();
      octx.moveTo(X(-MU), Y(0));
      octx.lineTo(X(1 - MU), Y(0));
      octx.lineTo(X(s[0]), Y(s[1]));
      octx.closePath();
      octx.stroke();
      octx.setLineDash([]);

      // L4 marker
      const l4x = X(0.5 - MU);
      const l4y = Y(Math.sqrt(3) / 2);
      octx.strokeStyle = col.muted;
      octx.beginPath();
      octx.moveTo(l4x - 5, l4y);
      octx.lineTo(l4x + 5, l4y);
      octx.moveTo(l4x, l4y - 5);
      octx.lineTo(l4x, l4y + 5);
      octx.stroke();

      if (trail.length > 3) {
        octx.strokeStyle = col.accent2;
        octx.globalAlpha = 0.5;
        octx.lineWidth = 1.5;
        octx.beginPath();
        octx.moveTo(X(trail[0]), Y(trail[1]));
        for (let i = 2; i < trail.length; i += 2) octx.lineTo(X(trail[i]), Y(trail[i + 1]));
        octx.stroke();
        octx.globalAlpha = 1;
      }

      const dot = (x: number, y: number, r2: number, fill: string) => {
        octx.fillStyle = fill;
        octx.beginPath();
        octx.arc(x, y, r2, 0, TAU);
        octx.fill();
      };
      dot(X(1 - MU), Y(0), 8, col.muted);
      dot(X(-MU), Y(0), 6, col.accent);
      dot(X(s[0]), Y(s[1]), 4.5, col.accent2);

      octx.fillStyle = col.muted;
      octx.font = '11px system-ui, sans-serif';
      octx.fillText('rotating frame, companion held still', 8, Ht - 8);
      octx.fillText('orbits: ' + (t / TAU).toFixed(2), 8, 16);
    }

    function drawStrip() {
      const r = strip.getBoundingClientRect();
      if (!fit(strip, sctx)) return;
      const W = r.width;
      const Ht = r.height;
      const mid = Ht / 2;
      const amp = Ht * 0.36;

      sctx.strokeStyle = col.border;
      sctx.lineWidth = 1;
      sctx.beginPath();
      sctx.moveTo(0, mid);
      sctx.lineTo(W, mid);
      sctx.stroke();

      if (trace.length < 8) {
        sctx.fillStyle = col.muted;
        sctx.font = '12px system-ui, sans-serif';
        sctx.fillText('Nothing recorded yet. Press play.', 10, mid - 8);
        return;
      }

      const span = KEEP * SAMPLE;
      const t0 = t - (trace.length - 1) * SAMPLE;
      const px = (i: number) => ((t0 + i * SAMPLE - (t - span)) / span) * W;

      sctx.strokeStyle = col.border;
      sctx.globalAlpha = 0.9;
      for (let k = Math.ceil((t - span) / TAU); k * TAU <= t; k++) {
        const x = ((k * TAU - (t - span)) / span) * W;
        sctx.beginPath();
        sctx.moveTo(x, 4);
        sctx.lineTo(x, Ht - 4);
        sctx.stroke();
      }
      sctx.globalAlpha = 1;

      sctx.strokeStyle = col.accent;
      sctx.lineWidth = 1.6;
      sctx.beginPath();
      for (let i = 0; i < trace.length; i++) {
        const y = mid - (trace[i] / 1.35) * amp;
        if (i === 0) sctx.moveTo(px(i), y);
        else sctx.lineTo(px(i), y);
      }
      sctx.stroke();

      sctx.fillStyle = col.muted;
      sctx.font = '11px system-ui, sans-serif';
      sctx.fillText('six orbits ago', 6, Ht - 6);
      sctx.textAlign = 'right';
      sctx.fillText('now', W - 6, Ht - 6);
      sctx.textAlign = 'left';
    }

    function draw() {
      drawOrbit();
      drawStrip();
    }

    function frame(now: number) {
      if (!playing) return;
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      advance(dt * RATE);
      draw();
      raf = requestAnimationFrame(frame);
    }

    function play() {
      if (playing) return;
      playing = true;
      playBtn.textContent = 'Pause';
      playBtn.setAttribute('aria-pressed', 'true');
      last = performance.now();
      raf = requestAnimationFrame(frame);
      status.textContent = 'Running. ' + pick.words;
    }

    function pause(quiet?: boolean) {
      if (!playing) return;
      playing = false;
      cancelAnimationFrame(raf);
      playBtn.textContent = 'Play';
      playBtn.setAttribute('aria-pressed', 'false');
      if (!quiet) status.textContent = 'Paused after ' + (t / TAU).toFixed(1) + ' orbits. ' + pick.words;
    }

    function select(id: string, speak: boolean) {
      const p = cfg.presets.find((x) => x.id === id);
      if (!p) return;
      pick = p;
      for (const b of root.querySelectorAll<HTMLButtonElement>('.preset'))
        b.setAttribute('aria-pressed', String(b.dataset.preset === id));
      place(p.deg);
      draw();
      if (speak) status.textContent = p.words;
    }

    for (const b of root.querySelectorAll<HTMLButtonElement>('.preset')) {
      b.addEventListener('click', () => {
        pause(true);
        select(b.dataset.preset!, true);
      });
    }
    playBtn.addEventListener('click', () => (playing ? pause() : play()));
    stepBtn.addEventListener('click', () => {
      pause(true);
      advance(TAU / 4);
      draw();
      status.textContent = 'Stepped forward a quarter orbit, now at ' + (t / TAU).toFixed(2) + ' orbits. ' + pick.words;
    });
    resetBtn.addEventListener('click', () => {
      pause(true);
      select(pick.id, false);
      status.textContent = 'Back to the start. ' + pick.words;
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause(true);
    });
    const ro = new ResizeObserver(() => draw());
    ro.observe(orbit);
    ro.observe(strip);
    const mo = new MutationObserver(() => {
      readColors();
      draw();
    });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      draw();
    });

    readColors();
    select(cfg.start, false);
    return { pause: () => pause(true) };
  }

  const roots = document.querySelectorAll<HTMLElement>('[data-explainer="trojan-libration"]');
  if (roots.length) {
    const live = new WeakMap<Element, { pause: () => void } | null>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          if (!live.has(e.target)) live.set(e.target, init(e.target as HTMLElement));
        } else {
          live.get(e.target)?.pause();
        }
      }
    });
    roots.forEach((r) => io.observe(r));
  }
</script>
