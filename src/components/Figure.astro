---
/**
 * One figure, in one of three shapes.
 *
 *   result     a scientific figure. Numbered, captioned, optionally linked
 *              to the full-resolution original.
 *   logo       an identity mark. Small, never numbered, never captioned.
 *   animation  a video. Poster frame until the reader presses play; it does
 *              not autoplay, and the poster is what gets printed.
 *
 * `alt` is required by the schema, so there is no silent-missing-alt path.
 */
import type { CollectionEntry } from 'astro:content';

type FigureData = CollectionEntry<'publications'>['data']['figures'][number];

interface Props {
  figure: FigureData;
  /** Figure number for kind: 'result'. Omitted means unnumbered. */
  number?: number;
}

const { figure, number } = Astro.props;
const { src, alt, caption, kind, video, full } = figure;

/* An animation entry normally points `src` at its own poster frame; take
   whichever of the two is present. */
const poster = video?.poster ?? (kind === 'animation' ? src : undefined);
const captionId = `fig-${src.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '')}`;
---

{
  kind === 'logo' && (
    <img class="logo" src={src} alt={alt} width="64" height="64" loading="lazy" decoding="async" />
  )
}

{
  kind === 'animation' && (
    <figure class="figure figure--animation">
      <video
        controls
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
        aria-describedby={captionId}
      >
        {video?.webm && <source src={video.webm} type="video/webm" />}
        {video?.mp4 && <source src={video.mp4} type="video/mp4" />}
        <p>
          Your browser will not play this video.{' '}
          {video?.mp4 && <a href={video.mp4}>Download the MP4 instead</a>}.
        </p>
      </video>

      {/* Paper gets the poster frame; the screen never sees this image. */}
      {poster && (
        <img class="figure-poster-print" src={poster} alt={alt} loading="lazy" decoding="async" />
      )}

      <figcaption id={captionId}>
        {number !== undefined && <span class="num">Figure {number}.</span>}
        {caption && <span class="text">{caption}</span>}
        <span class="alt-note">{alt}</span>
        {video?.mp4 && (
          <span class="dl">
            <a href={video.mp4}>Download the video</a>
          </span>
        )}
      </figcaption>
    </figure>
  )
}

{
  kind === 'result' && (
    <figure class="figure figure--result">
      <img src={src} alt={alt} loading="lazy" decoding="async" />
      <figcaption id={captionId}>
        {number !== undefined && <span class="num">Figure {number}.</span>}
        {caption && <span class="text">{caption}</span>}
        {full && (
          <span class="dl">
            <a href={full}>Full resolution</a>
          </span>
        )}
      </figcaption>
    </figure>
  )
}

<style>
  .figure {
    margin-block: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }

  .figure img,
  .figure video {
    width: 100%;
    height: auto;
    border-radius: 2px;
    background: var(--surface);
  }

  .figure-poster-print {
    display: none;
  }

  figcaption {
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .num {
    color: var(--text);
    font-weight: 600;
    margin-right: 0.35em;
  }

  .alt-note {
    display: block;
    margin-top: 0.4rem;
  }

  /* When there is a written caption the alt text would only repeat it. */
  .text ~ .alt-note {
    display: none;
  }

  .dl {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.88rem;
  }

  /* Both logo sources are artwork on a solid white background: the APTB PNG has
     an alpha channel but every pixel is opaque, and the ZOMBIES one is a JPEG,
     which cannot carry transparency at all. Dropped straight onto the page they
     read as white rectangles in dark mode. Sitting them on an explicit white
     card with a border makes that deliberate in both themes. */
  .logo {
    width: 56px;
    height: auto;
    max-height: 64px;
    object-fit: contain;
    margin-block: 1.25rem;
    background: #fff;
    padding: 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-sizing: content-box;
  }

  @media print {
    .logo {
      border-color: #ccc;
    }
  }
</style>
